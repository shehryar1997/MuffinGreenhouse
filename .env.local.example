# MGH Admin Session Environment Variables
# Copy this file to .env.local and fill in the values.

# Admin password (should be changed from default)
ADMIN_PASSWORD="admin123"

# Random secret for signing admin session tokens
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-random-secret-here"

# Secret for protecting cron job endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email service (optional)
RESEND_API_KEY="re_123456789"

# Sentry Error Monitoring (required for production)
# Get your DSN from https://sentry.io/organizations/your-org/projects/your-project/keys/
SENTRY_DSN="https://your-project-key.ingest.sentry.io/your-project-id"
# Optional: SENTRY_ORG, SENTRY_PROJECT for source maps
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"