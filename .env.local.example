

# --- Admin / server secrets (required in production) ---
# Admin login is DISABLED (fails closed) if SESSION_SECRET is unset outside `next dev`.
SESSION_SECRET=
ADMIN_PASSWORD=
# Extra password for /admin/email (POST /api/send-email)
SEND_PASSWORD=
# Bearer token Vercel Cron sends to /api/cron/expire-pending-orders
CRON_SECRET=
# Shared secret the Supabase webhook sends to /api/revalidate (x-revalidate-secret header)
REVALIDATE_SECRET=
# Google Analytics 4 (also enables the GA hosts in the CSP)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: shows a "Website traffic" panel on the admin dashboard (GA4 Data API, read-only).
# GA_PROPERTY_ID is the numeric Property ID (GA Admin > Property details), not the G-XXXX measurement ID.
# Create a Google Cloud service account, enable "Google Analytics Data API", then add the service account's
# e-mail as a Viewer in GA (Admin > Property access management). Paste the JSON key's private_key on ONE line,
# keeping the \n sequences as they are.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- E-mail (Resend first, Mailtrap as the backup: see lib/email/mailer.ts) ---
# Resend allows 100 e-mails a day / 3,000 a month. Needs a domain-verified sender (support@muffinplants.com).
# The "Full access" key is also used by /admin/email to show this month's usage.
RESEND_API_KEY=
# Optional backup: Mailtrap Email Sending (150 a day / 4,000 a month). When Resend says its daily or monthly
# limit is used up, e-mails go out through Mailtrap instead, so together they allow about 250 a day.
# Needs muffinplants.com added as a sending domain in Mailtrap: 4 CNAME records (set to "DNS only" in Cloudflare)
# plus a DMARC TXT record. There is no SPF record to add or merge: Mailtrap's SPF is covered by its verification
# CNAME, and Resend's SPF lives on send.muffinplants.com. Only one DMARC record may exist at _dmarc.
MAILTRAP_API_TOKEN=
# Optional: which provider goes first (default "resend,mailtrap").
EMAIL_PROVIDER_ORDER=
