

# --- Admin / server secrets (required in production) ---
# Admin login is DISABLED (fails closed) if SESSION_SECRET is unset outside `next dev`.
SESSION_SECRET=
ADMIN_PASSWORD=
# Extra password for /admin/email (POST /api/send-email)
SEND_PASSWORD=
# Bearer token Vercel Cron sends to /api/cron/expire-pending-orders
CRON_SECRET=
# Shared secret the Supabase webhook sends to /api/revalidate (x-revalidate-secret header)
REVALIDATE_SECRET=
# Google Analytics 4 (also enables the GA hosts in the CSP)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- E-mail (Resend first, Mailtrap as the backup: see lib/email/mailer.ts) ---
# Resend allows 100 e-mails a day / 3,000 a month. Needs a domain-verified sender (support@muffinplants.com).
# The "Full access" key is also used by /admin/email to show this month's usage.
RESEND_API_KEY=
# Optional backup: Mailtrap Email Sending (150 a day / 4,000 a month). When Resend says its daily or monthly
# limit is used up, e-mails go out through Mailtrap instead, so together they allow about 250 a day.
# Needs muffinplants.com added as a sending domain in Mailtrap (its DNS records are separate from Resend's,
# and both providers' SPF entries must be merged into ONE SPF record for the domain).
MAILTRAP_API_TOKEN=
# Optional: which provider goes first (default "resend,mailtrap").
EMAIL_PROVIDER_ORDER=
